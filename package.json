{
  "name": "nearly-afloat",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/dependency-notices.mjs",
    "deploy:check": "node scripts/deploy-preflight.mjs",
    "hosting:smoke": "node scripts/hosting-smoke.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "near:setup": "node --env-file-if-exists=.env.near-admin scripts/near-setup.mjs",
    "near:verify": "node scripts/near-verify.mjs",
    "start": "node --experimental-sqlite server.mjs",
    "start:embedded": "node --env-file-if-exists=.env.near-admin --env-file=.env.privy --experimental-sqlite server.mjs",
    "test": "node --experimental-sqlite --test \"test/*.test.mjs\"",
    "verify:candidate": "node scripts/verify-candidate.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@privy-io/js-sdk-core": "0.79.5",
    "jose": "6.2.17",
    "near-api-js": "7.4.0",
    "three": "^0.183.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "vite": "^7.3.1"
  }
}
